{
  "name": "clinear",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:engine",
    "build:engine": "esbuild engine/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-engine/main.mjs && esbuild engine/main.ts --bundle --platform=node --format=esm --packages=external --outfile=src-tauri/resources/engine/main.mjs && node scripts/engine-package.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "tsx --test tests/*.test.ts",
    "engine": "tsx engine/main.ts",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "test:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@cline/agents": "^0.0.95",
    "@composio/core": "0.25.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
