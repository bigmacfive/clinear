# Optional: Cline model inference. Default is Cline SDK + your local Codex login.
# ANTHROPIC_API_KEY=
# CLINE_API_KEY=

# Optional: without a key, Parallel's official anonymous Search MCP is used.
# PARALLEL_API_KEY=

# Required for the Composio connection route. Add it in Connections or here.
# COMPOSIO_API_KEY=

# Optional process overrides:
# CLINEAR_NODE=/absolute/path/to/node
# CLINEAR_DATA_DIR=/absolute/path/to/separate/test-data
