{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clinear",
  "version": "0.1.0",
  "identifier": "dev.clinear.app",
  "build": {
    "beforeDevCommand": "npm run build:engine && npm run dev",
    "devUrl": "http://127.0.0.1:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clinear",
        "width": 1500,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#131416",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/engine/": "engine/"
    },
    "category": "DeveloperTool",
    "shortDescription": "A shared workspace for people and local AI agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
